# ============================================================
# Football Prediction Engine — Environment Variables
# Copy this file to `.env` and fill in your keys.
# All values are optional: the pipeline falls back to mock data
# when keys are missing, so it runs end-to-end without them.
# ============================================================

# The Odds API (https://the-odds-api.com) — fallback live market odds.
# Multiple keys supported: comma-separate them for rotation.
ODDS_API_KEY=
ODDS_API_KEYS=

# API-Football (https://www.api-football.com) — fixtures, lineups,
# injuries, H2H, standings, historical results.
# Multiple keys supported: comma-separate them for rotation.
FOOTBALL_API_KEY=
FOOTBALL_API_KEYS=

# OddsPapi (https://oddspapi.io) — PRIMARY odds source. Free historical
# odds + line-movement, 300+ bookmakers. Auth: apiKey query param.
# Multiple keys supported: comma-separate them for rotation.
ODDSPAPI_KEY=
ODDSPAPI_KEYS=

# DeepSeek V4 Flash (via dahl.global inference API).
# Set DEEPSEEK_MODEL to the exact model id from your account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPSEEK_BASE_URL=https://inference.dahl.global/v1

# Notification webhooks (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pipeline control (overrides config.yaml)
# TARGET_ODDS is a soft target — the engine never forces low-confidence
# picks to hit it. MIN_CONFIDENCE is the hard floor for zero-cut execution
# (0.985 = a single leg fails only ~1.5% of the time).
TARGET_ODDS=300.0
MIN_CONFIDENCE=0.985
